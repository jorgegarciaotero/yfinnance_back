-- ─────────────────────────────────────────────────────────────────────────────
-- SECTOR DAILY OPPORTUNITIES — INCREMENTAL (tightened)
--
-- For each sector, extracts up to 3 companies in 3 setup categories:
--   1. Dip (Bullish Trend)  — controlled correction within a confirmed uptrend
--   2. Momentum (Leaders)   — only active when market breadth > 50% bullish
--   3. Value Reversal       — deep correction with positive earnings and signs of stabilisation
--
-- SCORE (0-100, 4 components × 25pts, varies by category).
-- A row only enters the table if score >= 60.
-- Output is hard-capped at 75 rows globally by score DESC.
--
-- Idempotent: deletes and inserts for max_date of enriched_prices_table.
-- ─────────────────────────────────────────────────────────────────────────────

DECLARE max_date DATE;
SET max_date = (
  SELECT MAX(date) FROM `yfinance-gcp.yfinance_raw.enriched_prices_table`
);

-- Idempotency: delete previous data for this day if job is re-run
DELETE FROM `yfinance-gcp.yfinance_raw.sector_daily_opportunities`
WHERE date = max_date;

INSERT INTO `yfinance-gcp.yfinance_raw.sector_daily_opportunities`
WITH

-- ── Latest company metadata (most recent weekly snapshot) ─────────────────────
latest_companies AS (
  SELECT symbol, short_name, business_summary
  FROM `yfinance-gcp.yfinance_raw.companies`
  QUALIFY ROW_NUMBER() OVER (PARTITION BY symbol ORDER BY updated_at DESC) = 1
),

-- ── Base universe with liquidity gate ─────────────────────────────────────────
-- Defensive dedup: enriched_prices_table is currently producing 4 rows per
-- (date, symbol) — keep one until the upstream MERGE is fixed.
base AS (
  SELECT *
  FROM `yfinance-gcp.yfinance_raw.enriched_prices_table`
  WHERE date = max_date
    AND sector IS NOT NULL AND sector != ''
    AND close > 5
    AND market_cap > 2000000000
    AND close * volume > 10000000
    AND dist_sma_200 > -0.05 -- Exclude broken stocks
    AND trailing_eps > 0     -- Must be profitable
  QUALIFY ROW_NUMBER() OVER (PARTITION BY symbol ORDER BY date) = 1
),

-- ── Market regime: bullish if breadth >= 50% of base universe ────────────────
market_regime AS (
  SELECT
    COUNTIF(long_term_trend = 'Bullish') / NULLIF(COUNT(*), 0) AS breadth_bullish_pct
  FROM base
),

-- ── Category 1: Dip on confirmed uptrend ─────────────────────────────────────
dip AS (
  SELECT
    date, sector, industry, symbol,
    'Dip (Bullish Trend)'               AS setup_type,
    ROUND(close, 2)                     AS close,
    ROUND(market_cap / 1e9, 2)          AS market_cap_bn,
    rsi_14,
    ROUND(momentum_10d * 100, 2)        AS momentum_10d_pct,
    ROUND(dist_sma_200 * 100, 2)        AS dist_sma200_pct,
    ROUND(pct_from_52w_high * 100, 2)   AS pct_from_52w_high,
    ROUND(pct_from_52w_low * 100, 2)    AS pct_from_52w_low,
    pe_ratio,
    recommendation_key,
    -- Score (0-100):
    --   A (25): RSI oversold depth   — RSI 30=25pts, RSI 40=0pts
    --   B (25): Trend health SMA200  — +5%=0, +25%=25pts
    --   C (25): Analyst consensus
    --   D (25): Market cap quality   — $2B=0, $50B+=25pts
    ROUND(
        LEAST(25, GREATEST(0, (40.0 - rsi_14) / 10.0 * 25))
      + LEAST(25, GREATEST(0, (dist_sma_200 - 0.05) / 0.20 * 25))
      + CASE recommendation_key WHEN 'strong_buy' THEN 25 WHEN 'buy' THEN 15 ELSE 5 END
      + LEAST(25, GREATEST(0, (market_cap - 2e9) / 48e9 * 25))
    , 1) AS score
  FROM base
  WHERE long_term_trend = 'Bullish'
    AND rsi_14 BETWEEN 30 AND 40
    AND dist_sma_200 > 0.05
    AND momentum_10d BETWEEN -0.10 AND -0.01
),

-- ── Category 2: Momentum leaders (only when market regime is bullish) ────────
momentum AS (
  SELECT
    date, sector, industry, symbol,
    'Momentum (Leaders)'                AS setup_type,
    ROUND(close, 2)                     AS close,
    ROUND(market_cap / 1e9, 2)          AS market_cap_bn,
    rsi_14,
    ROUND(momentum_10d * 100, 2)        AS momentum_10d_pct,
    ROUND(dist_sma_200 * 100, 2)        AS dist_sma200_pct,
    ROUND(pct_from_52w_high * 100, 2)   AS pct_from_52w_high,
    ROUND(pct_from_52w_low * 100, 2)    AS pct_from_52w_low,
    pe_ratio,
    recommendation_key,
    -- Score (0-100):
    --   A (25): Momentum strength    — +5%=0, +15%=25pts
    --   B (25): RSI sweet spot       — bell curve centred at 62 (strong momentum zone)
    --   C (25): Near 52w high        — -7%=0pts, 0%=25pts
    --   D (25): Analyst consensus
    ROUND(
        LEAST(25, GREATEST(0, (momentum_10d - 0.05) / 0.10 * 25))
      + LEAST(25, GREATEST(0, 25.0 * (1.0 - POW((rsi_14 - 62.0) / 8.0, 2))))
      + LEAST(25, GREATEST(0, (pct_from_52w_high + 0.07) / 0.07 * 25))
      + CASE recommendation_key WHEN 'strong_buy' THEN 25 WHEN 'buy' THEN 15 ELSE 5 END
    , 1) AS score
  FROM base, market_regime
  WHERE market_regime.breadth_bullish_pct >= 0.50
    AND long_term_trend = 'Bullish'
    AND pct_from_52w_high > -0.07
    AND rsi_14 BETWEEN 55 AND 70
    AND momentum_10d > 0.05
),

-- ── Category 3: Value Reversal with stabilisation gate ───────────────────────
value_rev AS (
  SELECT
    date, sector, industry, symbol,
    'Value Reversal'                    AS setup_type,
    ROUND(close, 2)                     AS close,
    ROUND(market_cap / 1e9, 2)          AS market_cap_bn,
    rsi_14,
    ROUND(momentum_10d * 100, 2)        AS momentum_10d_pct,
    ROUND(dist_sma_200 * 100, 2)        AS dist_sma200_pct,
    ROUND(pct_from_52w_high * 100, 2)   AS pct_from_52w_high,
    ROUND(pct_from_52w_low * 100, 2)    AS pct_from_52w_low,
    pe_ratio,
    recommendation_key,
    -- Score (0-100):
    --   A (25): PE quality           — PE 18=0, PE 5=25pts
    --   B (25): Stabilisation        — momentum -5%=0, +3%=25pts (turning up)
    --   C (25): Analyst consensus
    --   D (25): Market cap quality   — $2B=0, $50B+=25pts
    ROUND(
        LEAST(25, GREATEST(0, (18.0 - pe_ratio) / 13.0 * 25))
      + LEAST(25, GREATEST(0, (momentum_10d + 0.05) / 0.08 * 25))
      + CASE recommendation_key WHEN 'strong_buy' THEN 25 WHEN 'buy' THEN 15 ELSE 5 END
      + LEAST(25, GREATEST(0, (market_cap - 2e9) / 48e9 * 25))
    , 1) AS score
  FROM base
  WHERE pct_from_52w_high BETWEEN -0.50 AND -0.30
    AND pe_ratio > 0 AND pe_ratio < 18
    AND trailing_eps > 0
    AND rsi_14 > 35
    AND momentum_10d > -0.05
    AND recommendation_key IN ('buy', 'strong_buy')
),

all_candidates AS (
  SELECT * FROM dip
  UNION ALL SELECT * FROM momentum
  UNION ALL SELECT * FROM value_rev
),

-- Quality gate (score >= 60) + Top 3 per (sector, setup) by score DESC
ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY sector, setup_type ORDER BY score DESC, symbol) AS rank_in_sector
  FROM all_candidates
  WHERE score >= 60
),

-- Global cap of 75 by score DESC
capped AS (
  SELECT *
  FROM ranked
  WHERE rank_in_sector <= 3
  QUALIFY ROW_NUMBER() OVER (ORDER BY score DESC, sector, setup_type, symbol) <= 75
)

SELECT
  a.date,
  a.sector,
  a.industry,
  a.symbol,
  a.setup_type,
  a.close,
  a.market_cap_bn,
  a.rsi_14,
  a.momentum_10d_pct,
  a.dist_sma200_pct,
  a.pct_from_52w_high,
  a.pct_from_52w_low,
  a.pe_ratio,
  a.recommendation_key,
  a.score,
  a.rank_in_sector,
  CASE a.setup_type
    WHEN 'Dip (Bullish Trend)' THEN CONCAT(
      'Bullish trend with RSI ', FORMAT('%.0f', a.rsi_14), ' in oversold zone. ',
      'Momentum ', FORMAT('%.1f', a.momentum_10d_pct), '% in 10d (controlled dip). ',
      FORMAT('%.1f', a.dist_sma200_pct), '% above SMA200. ',
      'Analysts: ', a.recommendation_key, '.'
    )
    WHEN 'Momentum (Leaders)' THEN CONCAT(
      'Momentum +', FORMAT('%.1f', a.momentum_10d_pct), '% in 10d. ',
      'RSI ', FORMAT('%.0f', a.rsi_14), ' (momentum zone). ',
      FORMAT('%.1f', a.pct_from_52w_high), '% from 52w high. ',
      'Analysts: ', a.recommendation_key, '.'
    )
    WHEN 'Value Reversal' THEN CONCAT(
      FORMAT('%.1f', a.pct_from_52w_high), '% from 52w high (deep correction). ',
      'PE ', FORMAT('%.1f', a.pe_ratio), 'x with positive EPS. ',
      'Stabilising: momentum_10d ', FORMAT('%.1f', a.momentum_10d_pct), '%. ',
      'Analysts: ', a.recommendation_key, '.'
    )
  END AS reason,
  c.short_name                                            AS company_name,
  CONCAT('https://finance.yahoo.com/quote/', a.symbol)  AS company_url,
  LEFT(c.business_summary, 500)                          AS company_summary,
  CAST(NULL AS STRING)                                   AS top_news_title,
  CAST(NULL AS STRING)                                   AS top_news_url,
  CAST(NULL AS STRING)                                   AS narrative
FROM capped a
LEFT JOIN latest_companies c ON c.symbol = a.symbol
ORDER BY a.score DESC, a.sector, a.setup_type, a.rank_in_sector;
